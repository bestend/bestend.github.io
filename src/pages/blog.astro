---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = await getCollection('posts');
const sortedPosts = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const df = new Intl.DateTimeFormat('ko-KR', {
  year: '2-digit',
  month: '2-digit',
  day: '2-digit',
});

function formatDate(d: Date): string {
  // "26. 01. 11." -> "26.01.11"
  return df
    .format(d)
    .replaceAll('. ', '.')
    .replaceAll(' ', '')
    .replace(/\.$/, '');
}
---

<BaseLayout title="Blog">
  <div class="container mx-auto px-4 py-6 sm:py-8">
    <h1 class="text-xl sm:text-2xl font-bold text-text-primary mb-4">
      Blog
    </h1>

    <!-- 고밀도 리스트: 제목(최대 2줄) + 날짜만. excerpt는 제거 -->
    <ul class="border-t border-border divide-y divide-border">
      {sortedPosts.map((post) => (
        <li>
          <a
            href={`/blog/${post.slug}`}
            class="group block py-3 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary"
          >
            <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
              <h2 class="text-[13px] sm:text-sm font-medium leading-snug text-text-primary group-hover:text-accent transition-colors line-clamp-2">
                {post.data.title}
              </h2>
              <time class="text-[11px] sm:text-xs text-text-tertiary tabular-nums shrink-0">
                {formatDate(post.data.date)}
              </time>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
