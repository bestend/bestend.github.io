---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = await getCollection('posts');
const sortedPosts = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const df = new Intl.DateTimeFormat('ko-KR', {
  year: '2-digit',
  month: '2-digit',
  day: '2-digit',
});

function formatDate(d: Date): string {
  // "26. 01. 11." -> "26.01.11"
  return df
    .format(d)
    .replaceAll('. ', '.')
    .replaceAll(' ', '')
    .replace(/\.$/, '');
}
---

<BaseLayout title="Blog">
  <div class="container mx-auto px-4 py-12">
    <div class="max-w-3xl">
      <h1 class="text-3xl font-bold text-text-primary mb-8">
        Blog
      </h1>

      <!-- 밀도/가독성 우선: 제목 + 날짜만. 잘림/요약/카드 UI 제거 -->
      <ul class="divide-y divide-border">
        {sortedPosts.map((post) => (
          <li>
            <a
              href={`/blog/${post.slug}`}
              class="group block min-h-[44px] -mx-2 px-2 py-2 rounded-md hover:bg-bg-secondary transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary"
            >
              <div class="flex gap-2 sm:gap-3 items-start">
                <time class="shrink-0 text-[10px] sm:text-[11px] text-text-tertiary font-mono tabular-nums mt-[2px]">
                  {formatDate(post.data.date)}
                </time>

                <h2 class="min-w-0 flex-1 text-[12px] sm:text-[13px] font-medium leading-tight text-text-primary break-words group-hover:underline group-hover:underline-offset-2">
                  {post.data.title}
                </h2>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</BaseLayout>
