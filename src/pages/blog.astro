---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = await getCollection('posts');
const sortedPosts = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// 본문 첫 n자 추출 함수 (UI에서 line-clamp로 2줄 제한)
function getExcerpt(body: string, length: number = 220): string {
  return body.slice(0, length).replace(/\n/g, ' ').trim() + '...';
}
---

<BaseLayout title="Blog">
  <div class="container mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-text-primary mb-8">
      Blog
    </h1>

    <!-- 카드 그리드 대신 compact list로 전환 (글이 많아질수록 밀도가 좋음) -->
    <ul class="border border-border rounded-lg bg-bg-primary divide-y divide-border">
      {sortedPosts.map((post) => (
        <li>
          <a
            href={`/blog/${post.slug}`}
            class="group block px-4 py-4 hover:bg-bg-secondary transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg-primary"
          >
            <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
              <h2 class="text-base font-semibold text-text-primary group-hover:text-accent transition-colors">
                {post.data.title}
              </h2>
              <time class="text-xs text-text-tertiary">
                {post.data.date.toLocaleDateString('ko-KR')}
              </time>
            </div>

            <p class="mt-2 text-sm text-text-secondary line-clamp-2">
              {getExcerpt(post.body)}
            </p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
