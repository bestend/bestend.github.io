---
import CandyButton from './CandyButton.astro';
---

<section id="hero" class="relative min-h-screen flex items-center justify-center overflow-hidden" aria-labelledby="hero-heading">
  <!-- Decorative bouncing circle (desktop only) -->
  <div
    class="hidden md:block absolute top-24 right-[12%] w-20 h-20 border-[3px] border-dashed border-fg/30 rounded-full animate-bounce-gentle pointer-events-none"
    aria-hidden="true"
  ></div>

  <!-- Hand-drawn corner marks (desktop only) -->
  <div class="hidden md:block absolute top-[30%] left-[8%] pointer-events-none" aria-hidden="true">
    <svg width="40" height="40" viewBox="0 0 40 40" fill="none" class="text-fg/20">
      <path d="M2 38 L2 2 L38 2" stroke="currentColor" stroke-width="3" stroke-linecap="round" fill="none"/>
    </svg>
  </div>
  <div class="hidden md:block absolute bottom-[25%] right-[10%] pointer-events-none" aria-hidden="true">
    <svg width="40" height="40" viewBox="0 0 40 40" fill="none" class="text-fg/20">
      <path d="M38 2 L38 38 L2 38" stroke="currentColor" stroke-width="3" stroke-linecap="round" fill="none"/>
    </svg>
  </div>

  <div class="relative z-10 text-center px-6 md:px-8 max-w-3xl mx-auto">
    <h1 id="hero-heading" class="font-heading font-700 text-5xl md:text-7xl text-fg mb-3">
      JunSeok Kim<span class="inline-block text-accent rotate-6 ml-1">!</span>
    </h1>
    <p class="font-heading font-700 text-2xl md:text-4xl text-blue mb-6">
      AI/ML Engineer
    </p>
    <p class="text-fg/70 text-lg md:text-xl max-w-xl mx-auto mb-10 leading-relaxed">
      Building ML systems serving millions at Naver
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 relative">
      <!-- Hand-drawn arrow pointing to buttons (desktop only) -->
      <svg class="hidden md:block absolute -top-12 -right-16 w-16 h-14 text-fg/30 pointer-events-none" viewBox="0 0 60 50" fill="none" aria-hidden="true">
        <path d="M50 5 Q30 5 20 25 Q15 35 10 45" stroke="currentColor" stroke-width="2" stroke-dasharray="4 3" stroke-linecap="round" fill="none"/>
        <path d="M5 38 L10 46 L17 40" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/>
      </svg>

      <CandyButton href="https://github.com/bestend" external>
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
        GitHub
      </CandyButton>
      <CandyButton href="https://linkedin.com/in/%EA%B9%80%EC%A4%80%EC%84%9D-1983/" variant="secondary" external>
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
        LinkedIn
      </CandyButton>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce-down" aria-hidden="true">
    <svg class="w-7 h-7 text-fg/30" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" stroke-linecap="round">
      <path d="M19 9l-7 7-7-7" />
    </svg>
  </div>
</section>
