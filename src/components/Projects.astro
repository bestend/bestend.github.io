---
import StickerCard from './StickerCard.astro';
import SkillTag from './SkillTag.astro';
import CandyButton from './CandyButton.astro';

const projects = [
  {
    name: 'Kidsnote',
    desc: 'CLI tool for downloading Kidsnote albums — bulk download with browser automation',
    tags: ['Python', 'CLI'],
    url: 'https://github.com/bestend/kidsnote',
    rotate: '-rotate-1',
    decoration: 'tack' as const,
  },
  {
    name: 'S3lync',
    desc: 'Work with S3 objects like local files — Pythonic API with auto sync & hash verification',
    tags: ['Python', 'AWS S3'],
    url: 'https://github.com/bestend/s3lync',
    rotate: 'rotate-1',
    decoration: 'tape' as const,
  },
  {
    name: 'FastAPI Bootstrap',
    desc: 'Production-ready FastAPI boilerplate with smart logging, exception handling & tracing',
    tags: ['Python', 'FastAPI'],
    url: 'https://github.com/bestend/fastapi-bootstrap',
    rotate: '',
    decoration: 'tack' as const,
  },
  {
    name: 'Confee',
    desc: 'Type-safe configuration management with Pydantic V2 & multi-source support',
    tags: ['Python', 'Type-safe'],
    url: 'https://github.com/bestend/confee',
    rotate: '-rotate-1',
    decoration: 'tape' as const,
  },
];
---

<section id="projects" class="py-20 px-6 md:px-8" aria-labelledby="projects-heading">
  <div class="max-w-5xl mx-auto">
    <h2 id="projects-heading" class="font-heading font-700 text-4xl md:text-5xl text-fg mb-16 text-center">
      <span class="wavy-underline">Projects</span>
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {projects.map((p) => (
        <StickerCard postit decoration={p.decoration} rotate={p.rotate} class="p-6 pt-7 flex flex-col">
          <h3 class="font-heading font-700 text-2xl text-fg mb-2">{p.name}</h3>
          <p class="text-base text-fg/70 mb-4 flex-1">{p.desc}</p>
          <div class="flex flex-wrap gap-2 mb-5">
            {p.tags.map((tag) => (
              <SkillTag label={tag} />
            ))}
          </div>
          <CandyButton href={p.url} external class="self-start text-base px-5 py-2 min-h-10">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            View on GitHub
          </CandyButton>
        </StickerCard>
      ))}
    </div>
  </div>
</section>
